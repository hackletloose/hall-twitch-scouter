[Unit]
Description=player search – search players all over all known apis
After=network.target

[Service]
User=<your-username>
WorkingDirectory=/path/to/your/hall-twitch-scouter
ExecStart=/usr/bin/python3 /path/to/your/hall-twitch-scouter/player_search.py
Restart=always

[Install]
WantedBy=multi-user.target
